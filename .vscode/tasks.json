{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Aristotle3D",
            "type": "shell",
            "command": "make",
            "args": [
                "config=debug_x64",
                "-j8"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean Aristotle3D",
            "type": "shell",
            "command": "make",
            "args": [
                "clean",
                "config=debug_x64"
            ],
            "problemMatcher": []
        }
    ]
}